# ==============================================================================
# Versaly CRM - Production Environment Configuration Template
# ==============================================================================

# Database Connection URL
# For production on Vercel, use a hosted PostgreSQL instance (e.g., Supabase, Neon, Railway, or Vercel Postgres)
DATABASE_URL="postgresql://username:password@hostname:5432/versaly_db?sslmode=require"
# For local SQLite development:
# DATABASE_URL="file:./dev.db"

# NextAuth Authentication & Security
# Generate a secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secure-random-32-character-secret"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Platform Super Admin
PLATFORM_ADMIN_EMAIL="versalylabs@gmail.com"
PLATFORM_ADMIN_EMAILS="versalylabs@gmail.com"

# SMTP Email Configuration (Used for Contact Inquiries, Welcome Emails, Invites)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="versalylabs@gmail.com"
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD="your-16-character-app-password"
SMTP_FROM="Versaly CRM <versalylabs@gmail.com>"

# Omnichannel & Webhook Verification
INBOX_WEBHOOK_VERIFY_TOKEN="straten_inbox_verify_token"
META_WEBHOOK_VERIFY_TOKEN="straten_inbox_verify_token"
META_APP_SECRET="your-meta-app-secret"

# WhatsApp Cloud API (Optional if configuring via UI)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_GRAPH_API_VERSION="v21.0"

# Stripe Subscriptions & Billing (Optional)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_GROWTH_PRO_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""

# External Lead Capture API (Optional)
LEAD_CAPTURE_API_KEY=""
LEAD_CAPTURE_ALLOWED_ORIGIN="*"
