# ==============================================================================
# Versaly CRM - Production Environment Configuration Template
# ==============================================================================

# Database Connection URL
# For production on Vercel, use a hosted PostgreSQL instance (e.g., Supabase, Neon, Railway, or Vercel Postgres)
DATABASE_URL="postgresql://username:password@hostname:5432/versaly_db?sslmode=require"
# Local development ALSO needs PostgreSQL (e.g. a free Neon branch or a local Postgres). SQLite is no longer supported.

# NextAuth Authentication & Security
# Generate a secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secure-random-32-character-secret"   # REQUIRED - the app refuses to start without it
# Encrypts stored channel credentials (WhatsApp/Meta tokens). 64 hex chars: openssl rand -hex 32
CHANNEL_ENCRYPTION_KEY=""
NEXTAUTH_URL="https://your-domain.vercel.app"

# Platform Super Admin
PLATFORM_ADMIN_EMAIL="versalylabs@gmail.com"
PLATFORM_ADMIN_EMAILS="versalylabs@gmail.com"

# SMTP Email Configuration (Used for Contact Inquiries, Welcome Emails, Invites)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="versalylabs@gmail.com"
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD="your-16-character-app-password"
SMTP_FROM="Versaly CRM <versalylabs@gmail.com>"

# Omnichannel & Webhook Verification
INBOX_WEBHOOK_VERIFY_TOKEN="replace-with-a-long-random-string"
META_WEBHOOK_VERIFY_TOKEN="replace-with-a-long-random-string"
META_APP_SECRET="your-meta-app-secret"

# Platform-level channel credentials below are used ONLY by the workspace whose slug is PLATFORM_ORG_SLUG
PLATFORM_ORG_SLUG="versaly-hq"
# Inbox simulation is disabled in production unless set to true (demo only)
ALLOW_INBOX_SIMULATION="false"

# WhatsApp Cloud API (Optional if configuring via UI)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_GRAPH_API_VERSION="v21.0"


# Background Automation & Cron Security
CRON_SECRET="your-secure-random-cron-secret"

# External Lead Capture API (Optional)
LEAD_CAPTURE_API_KEY=""

# Public https address Safaricom calls back and customers open pay links on (defaults to NEXTAUTH_URL)
PUBLIC_APP_URL=""
LEAD_CAPTURE_ALLOWED_ORIGIN="*"

# Shared rate limiting across serverless instances (Upstash Redis REST). Optional: without it each instance limits on its own.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Paystack (Kenya: card + M-Pesa). Use sk_test_/pk_test_ keys locally. Webhook URL: <app>/api/billing/paystack-webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
