// Prisma schema for Straten Agency CRM
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

// Pipeline stages enum
enum PipelineStage {
  NEW_LEAD
  RESEARCHING
  CONTACTED
  FOLLOW_UP
  INTERESTED
  PROPOSAL
  WON
  LOST
}

// Lead source enum
enum LeadSource {
  REFERRAL
  COLD_OUTREACH
  SOCIAL_MEDIA
  WEBSITE_FORM
  EVENT
  OTHER
}

// Real estate business type enum
enum BusinessType {
  RESIDENTIAL_AGENT
  COMMERCIAL_AGENT
  PROPERTY_MANAGER
  INVESTOR
  DEVELOPER
  APPRAISER
  INSPECTOR
  OTHER
}

// Outreach status enum
enum CalendarEventType {
  MEETING
  CALL
  FOLLOW_UP
  PROPERTY_VIEWING
  OTHER
}

enum OutreachStatus {
  PENDING
  SENT
  OPENED
  CLICKED
  REPLIED
  BOUNCED
}

model Lead {
  id                 String      @id @default(uuid())
  companyName        String?
  contactName        String
  jobTitle           String?
  email              String
  phone              String?
  website            String?
  location           String?
  businessType       BusinessType?
  instagram          String?
  linkedin           String?
  facebook           String?
  tiktok             String?
  xHandle            String?
  leadSource         LeadSource
  pipelineStage      PipelineStage @default(NEW_LEAD)
  outreachStatus     OutreachStatus @default(PENDING)
  dealValue          Float?
  dateAdded          DateTime    @default(now())
  lastContact        DateTime?
  nextFollowUp       DateTime?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relations
  outreachLogs       OutreachLog[]
  tasks              Task[]
  proposals          Proposal[]
  activityEvents     ActivityEvent[]
  calendarEvents     CalendarEvent[]
  customerSuccess   CustomerSuccessRecord?
  aiInsight         AiDealInsight?
  meetingSummaries  AiMeetingSummary[]
  conversations     Conversation[]
  channelIdentities ContactChannelIdentity[]
  assignedToId       String?
  assignedTo         User?       @relation("LeadAssignee", fields: [assignedToId], references: [id])
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id])

  @@index([assignedToId])
  @@index([organizationId])
  @@unique([organizationId, email])
}

model OutreachLog {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id])
  type       String   // email, call, sms, linkedin, etc.
  subject    String?
  content    String?
  status     OutreachStatus
  sentAt     DateTime @default(now())
  openedAt   DateTime?
  clickedAt  DateTime?
  repliedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([leadId])
}

model CalendarEvent {
  id            String            @id @default(uuid())
  leadId        String?
  lead          Lead?             @relation(fields: [leadId], references: [id])
  title         String
  description   String?
  type          CalendarEventType @default(MEETING)
  startAt       DateTime
  endAt         DateTime?
  location      String?
  completed     Boolean           @default(false)
  reminderAt    DateTime?
  assignedToId  String?
  assignedTo    User?             @relation("CalendarEventAssignee", fields: [assignedToId], references: [id])
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([leadId])
  @@index([assignedToId])
  @@index([startAt])
  @@index([organizationId])
}

model Task {
  id          String   @id @default(uuid())
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean  @default(false)
  priority    String   // low, medium, high
  assignedToId String?
  assignedTo   User?    @relation("TaskAssignee", fields: [assignedToId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
  @@index([assignedToId])
  @@index([organizationId])
}

model Proposal {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id])
  title       String
  description String?
  value       Float?
  status      String   // draft, sent, accepted, rejected
  sentAt      DateTime?
  respondedAt DateTime?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
  @@index([organizationId])
}


model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  body      String
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutomationWorkflow {
  id            String   @id @default(uuid())
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  triggerType   String
  triggerConfig Json?
  actionType    String
  actionConfig  Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  executions    AutomationExecution[]
  @@unique([organizationId, name])
  @@index([organizationId, isActive, triggerType])
}

model AutomationExecution {
  id           String             @id @default(uuid())
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId   String
  workflow     AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  leadId       String?
  triggerType  String
  status       String
  message      String?
  metadata     Json?
  executionKey String? @unique
  executedAt   DateTime           @default(now())
  @@index([organizationId, executedAt])
  @@index([workflowId, executedAt])
  @@index([leadId, executedAt])
}

model ActivityEvent {
  id        String   @id @default(uuid())
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  type      String   // login, page_view, etc.
  action    String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  @@index([leadId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sessionToken])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model NotificationPreference {
  id                     String  @id @default(uuid())
  userId                 String  @unique
  user                   User    @relation(fields: [userId], references: [id])
  taskNotifications      Boolean @default(true)
  leadNotifications      Boolean @default(true)
  followUpNotifications  Boolean @default(true)
  proposalNotifications  Boolean @default(true)
  calendarNotifications  Boolean @default(true)
  emailNotifications     Boolean @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model User {
  id            String   @id @default(uuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  image         String?
  password      String   // hashed password
  role          String   @default("AGENT") // ADMIN, MANAGER, AGENT
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Multi-Tenancy Organization
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Relations
  sessions      Session[]
  assignedLeads Lead[] @relation("LeadAssignee")
  assignedTasks Task[] @relation("TaskAssignee")
  assignedCalendarEvents CalendarEvent[] @relation("CalendarEventAssignee")
  customerSuccessRecords CustomerSuccessRecord[] @relation("CustomerSuccessOwner")
  notifications Notification[]
  notificationPreference NotificationPreference?
  supportTickets SupportTicket[] @relation("SupportRequester")
  supportMessages SupportMessage[] @relation("SupportMessageAuthor")
  assignedConversations Conversation[] @relation("ConversationAssignee")

  @@index([organizationId])
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  plan        String   @default("GROWTH_PRO") // STARTER, GROWTH_PRO, ENTERPRISE
  planStatus  String   @default("trialing") // trialing, active, past_due, canceled, incomplete
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  subscriptionPriceId  String?
  billingInterval      String?  // month, year
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  suspendedAt     DateTime?
  suspensionReason String?
  leadLimit   Int      @default(500)
  seatLimit   Int      @default(10)
  automationRunLimit Int @default(1000)
  currency    String   @default("KES")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users          User[]
  leads          Lead[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  proposals      Proposal[]
  supportTickets SupportTicket[]
  platformAuditLogs PlatformAuditLog[]
  automationWorkflows AutomationWorkflow[]
  automationExecutions AutomationExecution[]
  apiKeys       ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  customerSuccessRecords CustomerSuccessRecord[]
  aiDealInsights        AiDealInsight[]
  meetingSummaries      AiMeetingSummary[]
  conversations         Conversation[]
  connectedChannels     ConnectedChannelAccount[]
  channelIdentities     ContactChannelIdentity[]

  @@index([slug])
  @@index([suspendedAt])
}

model SupportTicket {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requesterId    String
  requester      User     @relation("SupportRequester", fields: [requesterId], references: [id])
  subject        String
  description    String
  status         String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING_ON_CUSTOMER, RESOLVED, CLOSED
  priority       String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  category       String   @default("GENERAL") // GENERAL, BILLING, BUG, ACCOUNT, FEATURE, SECURITY
  lastResponseAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  messages       SupportMessage[]

  @@index([organizationId, status, updatedAt])
  @@index([requesterId, createdAt])
}

model SupportMessage {
  id            String   @id @default(uuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId  String?
  authorUser    User?    @relation("SupportMessageAuthor", fields: [authorUserId], references: [id])
  authorEmail   String
  body          String
  isInternal    Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([ticketId, createdAt])
}

model PlatformAuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUserId    String?
  actorEmail     String
  action         String
  metadata      Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorEmail, createdAt])
}
model ProcessedWebhookEvent {
  id        String   @id @default(uuid())
  provider  String
  eventId   String   @unique
  eventType String
  processedAt DateTime @default(now())

  @@index([provider, processedAt])
}


model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyPrefix      String
  keyHash        String       @unique
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([organizationId, revokedAt])
}

model WebhookEndpoint {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  url            String
  secret         String
  events         Json
  isActive       Boolean      @default(true)
  lastDeliveredAt DateTime?
  failureCount   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deliveries     WebhookDelivery[]
  @@index([organizationId, isActive])
}

model WebhookDelivery {
  id          String          @id @default(uuid())
  organizationId String
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpointId  String
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event       String
  payload     Json
  statusCode  Int?
  response    String?
  success     Boolean         @default(false)
  attempt     Int             @default(1)
  deliveredAt DateTime?
  createdAt   DateTime        @default(now())
  @@index([organizationId, createdAt])
  @@index([endpointId, createdAt])
}

model CustomerSuccessRecord {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId           String       @unique
  lead             Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  lifecycleStage   String       @default("ONBOARDING") // ONBOARDING, ADOPTING, ACTIVE, AT_RISK, RENEWAL, CHURNED
  healthScore      Int          @default(50)
  healthStatus     String       @default("HEALTHY") // HEALTHY, WATCH, AT_RISK
  renewalDate      DateTime?
  renewalValue     Float?
  renewalStatus    String       @default("NOT_SET") // NOT_SET, UPCOMING, RENEWED, AT_RISK, CHURNED
  successOwnerId   String?
  successOwner     User?        @relation("CustomerSuccessOwner", fields: [successOwnerId], references: [id])
  lastReviewAt     DateTime?
  nextReviewAt     DateTime?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  milestones       CustomerMilestone[]

  @@index([organizationId, lifecycleStage])
  @@index([organizationId, healthStatus])
  @@index([organizationId, renewalDate])
}

model CustomerMilestone {
  id          String               @id @default(uuid())
  customerId  String
  customer    CustomerSuccessRecord @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([customerId, dueDate])
}

model AiDealInsight {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId          String       @unique
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sentimentScore  Int          @default(50)
  sentimentLabel  String       @default("NEUTRAL") // POSITIVE, NEUTRAL, CONCERN
  winProbability  Int          @default(50)
  churnRisk       String       @default("MEDIUM") // LOW, MEDIUM, HIGH
  buyingSignals   Json?
  objections      Json?
  suggestedActions Json?
  summaryNotes    String?
  analyzedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, sentimentLabel])
  @@index([organizationId, churnRisk])
  @@index([organizationId, winProbability])
}

model AiMeetingSummary {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  calendarEventId String?
  title           String
  rawTranscript   String
  summary         String
  actionItems     Json?
  objections      Json?
  keyDecisions    Json?
  sentiment       String       @default("NEUTRAL")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([leadId, createdAt])
}

model Conversation {
  id                  String               @id @default(uuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId              String?
  lead                Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  contactHandle       String?
  subject             String?
  status              String               @default("OPEN")  // OPEN, PENDING, RESOLVED, CLOSED, WAITING_ON_CUSTOMER
  priority            String               @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  assignedToId        String?
  assignedTo          User?                @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  channel             String               @default("EMAIL") // EMAIL, WHATSAPP, INSTAGRAM, FACEBOOK, X, TIKTOK, MULTI
  primaryChannel      String?
  lastMessageAt       DateTime             @default(now())
  lastMessageSnippet  String?
  lastMessagePreview  String?
  unreadCount         Int                  @default(0)
  isStarred           Boolean              @default(false)
  isArchived          Boolean              @default(false)
  isClosed            Boolean              @default(false)
  tags                Json?
  messages            ConversationMessage[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, isStarred])
  @@index([organizationId, isArchived])
  @@index([leadId])
  @@index([assignedToId])
  @@index([channel])
}

model ConversationMessage {
  id                String       @id @default(uuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel           String       // EMAIL, WHATSAPP, SMS, INSTAGRAM, FACEBOOK, TIKTOK, X, INTERNAL_NOTE
  direction         String       @default("OUTBOUND") // INBOUND, OUTBOUND
  senderType        String       // AGENT, LEAD, CUSTOMER, USER, SYSTEM, AI_COPILOT
  senderId          String?
  senderName        String?
  senderExternalId  String?
  content           String
  contentType       String       @default("TEXT") // TEXT, HTML, MEDIA, NOTE
  externalMessageId String?
  deliveryStatus    String       @default("SENT") // DRAFT, QUEUED, SENT, DELIVERED, READ, FAILED
  status            String       @default("SENT") // Backward compatibility
  readAt            DateTime?
  sentAt            DateTime     @default(now())
  receivedAt        DateTime?
  metadata          Json?
  attachments       Json?
  isInternal        Boolean      @default(false)
  createdAt         DateTime     @default(now())

  @@index([conversationId, sentAt])
  @@index([externalMessageId])
  @@index([channel])
}

model ContactChannelIdentity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel        String       // EMAIL, WHATSAPP, INSTAGRAM, FACEBOOK, X, TIKTOK
  externalUserId String
  username       String?
  displayName    String?
  profileUrl     String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, channel, externalUserId])
  @@index([organizationId, channel])
  @@index([leadId])
}

model ConnectedChannelAccount {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel           String       // INSTAGRAM, FACEBOOK, TIKTOK, X, WHATSAPP, EMAIL
  accountName       String       // e.g. "Straten CRM IG", "Straten FB Page", "Straten Agency X"
  accountHandle     String       // e.g. "@straten_agency", "straten_official", "@straten_crm"
  externalAccountId String?      // e.g. Meta Page ID, Instagram Business Account ID, TikTok Open ID, X User ID
  accessToken       String?      // API Token / OAuth User or Page Access Token
  refreshToken      String?      // Refresh token if applicable
  tokenExpiresAt    DateTime?
  appId             String?      // App ID / Client Key
  appSecret         String?      // App Secret / Client Secret
  webhookSecret     String?      // Webhook verification token
  status            String       @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR, PENDING
  lastSyncAt        DateTime?
  errorMessage      String?
  avatarUrl         String?
  metadata          Json?        // Channel specific metadata (scopes, permissions, followers)
  connectedAt       DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, channel, accountHandle])
  @@index([organizationId, channel])
  @@index([status])
}



